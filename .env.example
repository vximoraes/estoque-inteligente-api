# =============================================================================
# API
# =============================================================================
# Porta em que o servidor irá rodar
PORT=3010

# Porta do frontend utilizada no docker-compose
FRONTEND_PORT=3001

# Ambiente da aplicação (development/test/production)
NODE_ENV=development

# Ativa/desativa logs detalhados (true/false)
DEBUGLOG=true

# Desativa logs coloridos/formatados (ausente = pretty ativo por padrão)
# LOG_PRETTY=false

# =============================================================================
# BANCO DE DADOS
# =============================================================================
# URL de conexão com o banco MongoDB
# Exemplos:
#   Local:  mongodb://localhost:27017/estoque-inteligente
#   Atlas:  mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/estoque-inteligente?retryWrites=true&w=majority
#   Docker: mongodb://mongodb:27017/estoque-inteligente (configurado no docker-compose)
DB_URL=mongodb://localhost:27017/estoque-inteligente

# URL de conexão com o banco de testes (opcional)
DB_URL_TEST=mongodb://localhost:27017/estoque-inteligente-test

# =============================================================================
# RBAC
# =============================================================================
# Dominio usado pelo RBAC pra casar Rota/Grupo (multi-dominio nao é usado hoje,
# so precisa bater com o valor semeado em rotasSeed.ts)
RBAC_DOMINIO=localhost

# =============================================================================
# BETTER AUTH
# =============================================================================
# Secret para assinar sessões (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=GERE_UMA_CHAVE_SECRETA_32_BYTES

# URL base desta API (usada pelo Better Auth para montar os endpoints)
BETTER_AUTH_URL=http://localhost:3010

# Login social com Google (Better Auth)
# Configurar em: https://console.cloud.google.com/apis/credentials
# Redirect URI autorizada: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI

# =============================================================================
# SERVIÇO DE E-MAIL
# =============================================================================
# Configurar conta Google para envio de e-mails:
# 1) Acesse https://myaccount.google.com/security e habilite 2-step verification
# 2) Acesse https://myaccount.google.com/apppasswords e gere uma senha de app
# 3) Use o e-mail do Google e a senha de app gerada

# E-mail que será usado para enviar os e-mails (Gmail)
EMAIL_USER=seu_email@gmail.com

# Senha de aplicativo gerada (Gmail)
EMAIL_APP_PASSWORD=sua_senha_de_app_aqui

# Nome da empresa (aparecerá no remetente dos e-mails)
COMPANY_NAME=Estoque Inteligente

# URL do frontend (para gerar links nos e-mails)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# MINIO
# =============================================================================
# Endpoint
MINIO_ENDPOINT=localhost

# Porta da API
MINIO_PORT=9000

# Porta do console web
MINIO_CONSOLE_PORT=9001

# Credenciais de acesso
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Buckets
MINIO_BUCKET=usuarios
MINIO_BUCKET_2=itens

# URL pública para acesso via navegador
MINIO_PUBLIC_URL=http://localhost:9000

# =============================================================================
# USUÁRIO ADMINISTRADOR
# =============================================================================
# Dados do usuário administrador que será criado nas seeds
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Senha@123

# =============================================================================
# IA
# =============================================================================
# Chave da API do Google Gemini
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=SUA_CHAVE_AQUI

# URL interna usada pelo IAService para conectar ao MCP server (loopback)
# Em produção com Docker, usar o nome do serviço: http://estoque-inteligente-api:3010
API_INTERNAL_URL=http://localhost:3010

# Modelo do Gemini usado pelo agente. Default: gemini-3.5-flash-lite.
# ATENÇÃO: gemini-2.5-flash tem shutdown anunciado para 2026-10-16 — não usar como default.
GEMINI_MODEL=gemini-3.5-flash-lite

# Teto de tokens de saída por chamada ao modelo (contenção de custo)
IA_MAX_OUTPUT_TOKENS=1536

# Orçamento de "thinking" do Gemini: 0 desativa (recomendado, thinking é cobrado
# como output e é invisível ao usuário), -1 é dinâmico (mais caro, sem teto por chamada)
IA_THINKING_BUDGET=0

# Nº máximo de passos do agente ReAct por mensagem (cada 2 passos ≈ 1 chamada ao modelo)
IA_RECURSION_LIMIT=6

# Timeout de uma resposta do agente, em milissegundos
IA_TIMEOUT_MS=45000

# Orçamento diário de tokens por usuário (contenção de custo por período)
IA_ORCAMENTO_TOKENS_DIA=150000

# Nº máximo de streams de chat simultâneos por usuário (contido em memória —
# reset no restart é o comportamento correto para trabalho em voo)
IA_MAX_STREAMS_SIMULTANEOS=2

# Nº máximo de conversas de IA por usuário
IA_MAX_CONVERSAS_POR_USUARIO=50
